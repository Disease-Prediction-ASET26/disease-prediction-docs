<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_DiseasePrediction"
                  targetNamespace="http://www.diseaseprediction.com/bpmn"
                  exporter="hand-authored" exporterVersion="1.0">

  <!-- ============================================================= -->
  <!-- Collaboration: three participants (pools)                     -->
  <!-- ============================================================= -->
  <bpmn:collaboration id="Collaboration_Assessment">
    <bpmn:participant id="Participant_Patient" name="Patient" processRef="Process_Patient"/>
    <bpmn:participant id="Participant_System" name="Disease Prediction System" processRef="Process_System"/>
    <bpmn:participant id="Participant_Doctor" name="Doctor" processRef="Process_Doctor"/>

    <!-- Message flows between pools -->
    <bpmn:messageFlow id="MF_SubmitAssessment" name="Submit assessment"
        sourceRef="Task_FillSymptoms" targetRef="StartEvent_System"/>
    <bpmn:messageFlow id="MF_EmergencyAlert" name="Emergency alert"
        sourceRef="Task_RaiseEmergency" targetRef="Event_PatientEmergency"/>
    <bpmn:messageFlow id="MF_ResultToPatient" name="Prediction result"
        sourceRef="Task_PersistResult" targetRef="Event_PatientResult"/>
    <bpmn:messageFlow id="MF_ReportToDoctor" name="Report sent"
        sourceRef="Task_SendReport" targetRef="StartEvent_Doctor"/>
    <bpmn:messageFlow id="MF_ReviewToPatient" name="Clinical review"
        sourceRef="Task_MarkReviewed" targetRef="Event_PatientReview"/>
  </bpmn:collaboration>

  <!-- ============================================================= -->
  <!-- Pool 1: PATIENT                                               -->
  <!-- ============================================================= -->
  <bpmn:process id="Process_Patient" name="Patient" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Patient" name="Decides to check symptoms">
      <bpmn:outgoing>Flow_P1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_StartAssessment" name="Start assessment">
      <bpmn:incoming>Flow_P1</bpmn:incoming>
      <bpmn:outgoing>Flow_P2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_FillSymptoms" name="Describe and add symptom entries">
      <bpmn:incoming>Flow_P2</bpmn:incoming>
      <bpmn:outgoing>Flow_P3</bpmn:outgoing>
    </bpmn:task>

    <!-- Event-based gateway: patient waits for one of several system responses -->
    <bpmn:eventBasedGateway id="Gateway_PatientWait" name="Await system response">
      <bpmn:incoming>Flow_P3</bpmn:incoming>
      <bpmn:outgoing>Flow_PtoEmergency</bpmn:outgoing>
      <bpmn:outgoing>Flow_PtoResult</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <bpmn:intermediateCatchEvent id="Event_PatientEmergency" name="Emergency alert received">
      <bpmn:incoming>Flow_PtoEmergency</bpmn:incoming>
      <bpmn:outgoing>Flow_PEmergEnd</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_PatEmerg"/>
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="Event_PatientResult" name="Prediction result received">
      <bpmn:incoming>Flow_PtoResult</bpmn:incoming>
      <bpmn:outgoing>Flow_P4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_PatResult"/>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_ReviewResult" name="Review predictions and disclaimer">
      <bpmn:incoming>Flow_P4</bpmn:incoming>
      <bpmn:outgoing>Flow_P5</bpmn:outgoing>
    </bpmn:task>

    <!-- Does the patient forward the report to a doctor? -->
    <bpmn:exclusiveGateway id="Gateway_ForwardReport" name="Forward to doctor?">
      <bpmn:incoming>Flow_P5</bpmn:incoming>
      <bpmn:outgoing>Flow_ForwardYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_ForwardNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_ForwardReport" name="Forward report to doctor">
      <bpmn:incoming>Flow_ForwardYes</bpmn:incoming>
      <bpmn:outgoing>Flow_P6</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="Event_PatientReview" name="Clinical review received">
      <bpmn:incoming>Flow_P6</bpmn:incoming>
      <bpmn:outgoing>Flow_P7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_PatReview"/>
    </bpmn:intermediateCatchEvent>

    <bpmn:endEvent id="EndEvent_PatientDone" name="Assessment complete">
      <bpmn:incoming>Flow_P7</bpmn:incoming>
      <bpmn:incoming>Flow_ForwardNo</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_PatientEmergency" name="Seek emergency care">
      <bpmn:incoming>Flow_PEmergEnd</bpmn:incoming>
      <bpmn:terminateEventDefinition id="TED_PatEmerg"/>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_P1" sourceRef="StartEvent_Patient" targetRef="Task_StartAssessment"/>
    <bpmn:sequenceFlow id="Flow_P2" sourceRef="Task_StartAssessment" targetRef="Task_FillSymptoms"/>
    <bpmn:sequenceFlow id="Flow_P3" sourceRef="Task_FillSymptoms" targetRef="Gateway_PatientWait"/>
    <bpmn:sequenceFlow id="Flow_PtoEmergency" sourceRef="Gateway_PatientWait" targetRef="Event_PatientEmergency"/>
    <bpmn:sequenceFlow id="Flow_PtoResult" sourceRef="Gateway_PatientWait" targetRef="Event_PatientResult"/>
    <bpmn:sequenceFlow id="Flow_PEmergEnd" sourceRef="Event_PatientEmergency" targetRef="EndEvent_PatientEmergency"/>
    <bpmn:sequenceFlow id="Flow_P4" sourceRef="Event_PatientResult" targetRef="Task_ReviewResult"/>
    <bpmn:sequenceFlow id="Flow_P5" sourceRef="Task_ReviewResult" targetRef="Gateway_ForwardReport"/>
    <bpmn:sequenceFlow id="Flow_ForwardYes" name="Yes" sourceRef="Gateway_ForwardReport" targetRef="Task_ForwardReport"/>
    <bpmn:sequenceFlow id="Flow_ForwardNo" name="No" sourceRef="Gateway_ForwardReport" targetRef="EndEvent_PatientDone"/>
    <bpmn:sequenceFlow id="Flow_P6" sourceRef="Task_ForwardReport" targetRef="Event_PatientReview"/>
    <bpmn:sequenceFlow id="Flow_P7" sourceRef="Event_PatientReview" targetRef="EndEvent_PatientDone"/>
  </bpmn:process>

  <!-- ============================================================= -->
  <!-- Pool 2: DISEASE PREDICTION SYSTEM                             -->
  <!-- ============================================================= -->
  <bpmn:process id="Process_System" name="Disease Prediction System" isExecutable="false">
    <bpmn:startEvent id="StartEvent_System" name="Assessment submitted">
      <bpmn:outgoing>Flow_S1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_SysStart"/>
    </bpmn:startEvent>

    <bpmn:task id="Task_MapSymptoms" name="Map symptom entries to canonical symptoms">
      <bpmn:incoming>Flow_S1</bpmn:incoming>
      <bpmn:outgoing>Flow_S2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CheckRedFlags" name="Check red-flag rules">
      <bpmn:incoming>Flow_S2</bpmn:incoming>
      <bpmn:outgoing>Flow_S3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_Emergency" name="Emergency detected?">
      <bpmn:incoming>Flow_S3</bpmn:incoming>
      <bpmn:outgoing>Flow_EmergYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_EmergNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_RaiseEmergency" name="Raise emergency alert">
      <bpmn:incoming>Flow_EmergYes</bpmn:incoming>
      <bpmn:outgoing>Flow_S_EmergEnd</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_SystemEmergency" name="Flow stopped (emergency)">
      <bpmn:incoming>Flow_S_EmergEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_RunModel" name="Run ML model prediction">
      <bpmn:incoming>Flow_EmergNo</bpmn:incoming>
      <bpmn:outgoing>Flow_S4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_BuildExplanation" name="Build ranked predictions and explanation">
      <bpmn:incoming>Flow_S4</bpmn:incoming>
      <bpmn:outgoing>Flow_S5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PersistResult" name="Persist prediction result and draft report">
      <bpmn:incoming>Flow_S5</bpmn:incoming>
      <bpmn:outgoing>Flow_S6</bpmn:outgoing>
    </bpmn:task>

    <!-- Does the patient choose to forward? The system sends the report on request. -->
    <bpmn:task id="Task_SendReport" name="Send report to doctor inbox">
      <bpmn:incoming>Flow_S6</bpmn:incoming>
      <bpmn:outgoing>Flow_S7</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_SystemDone" name="Result delivered">
      <bpmn:incoming>Flow_S7</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_S1" sourceRef="StartEvent_System" targetRef="Task_MapSymptoms"/>
    <bpmn:sequenceFlow id="Flow_S2" sourceRef="Task_MapSymptoms" targetRef="Task_CheckRedFlags"/>
    <bpmn:sequenceFlow id="Flow_S3" sourceRef="Task_CheckRedFlags" targetRef="Gateway_Emergency"/>
    <bpmn:sequenceFlow id="Flow_EmergYes" name="Yes" sourceRef="Gateway_Emergency" targetRef="Task_RaiseEmergency"/>
    <bpmn:sequenceFlow id="Flow_EmergNo" name="No" sourceRef="Gateway_Emergency" targetRef="Task_RunModel"/>
    <bpmn:sequenceFlow id="Flow_S_EmergEnd" sourceRef="Task_RaiseEmergency" targetRef="EndEvent_SystemEmergency"/>
    <bpmn:sequenceFlow id="Flow_S4" sourceRef="Task_RunModel" targetRef="Task_BuildExplanation"/>
    <bpmn:sequenceFlow id="Flow_S5" sourceRef="Task_BuildExplanation" targetRef="Task_PersistResult"/>
    <bpmn:sequenceFlow id="Flow_S6" sourceRef="Task_PersistResult" targetRef="Task_SendReport"/>
    <bpmn:sequenceFlow id="Flow_S7" sourceRef="Task_SendReport" targetRef="EndEvent_SystemDone"/>
  </bpmn:process>

  <!-- ============================================================= -->
  <!-- Pool 3: DOCTOR                                                -->
  <!-- ============================================================= -->
  <bpmn:process id="Process_Doctor" name="Doctor" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Doctor" name="Report received in inbox">
      <bpmn:outgoing>Flow_D1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_DocStart"/>
    </bpmn:startEvent>

    <bpmn:task id="Task_OpenReport" name="Open report">
      <bpmn:incoming>Flow_D1</bpmn:incoming>
      <bpmn:outgoing>Flow_D2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ReviewReport" name="Review predictions and patient data">
      <bpmn:incoming>Flow_D2</bpmn:incoming>
      <bpmn:outgoing>Flow_D3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_MarkReviewed" name="Add clinical notes and mark reviewed">
      <bpmn:incoming>Flow_D3</bpmn:incoming>
      <bpmn:outgoing>Flow_D4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Doctor" name="Review complete">
      <bpmn:incoming>Flow_D4</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_D1" sourceRef="StartEvent_Doctor" targetRef="Task_OpenReport"/>
    <bpmn:sequenceFlow id="Flow_D2" sourceRef="Task_OpenReport" targetRef="Task_ReviewReport"/>
    <bpmn:sequenceFlow id="Flow_D3" sourceRef="Task_ReviewReport" targetRef="Task_MarkReviewed"/>
    <bpmn:sequenceFlow id="Flow_D4" sourceRef="Task_MarkReviewed" targetRef="EndEvent_Doctor"/>
  </bpmn:process>

  <!-- ============================================================= -->
  <!-- Diagram Interchange (visual layout)                           -->
  <!-- ============================================================= -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_Assessment">

      <!-- ===== Patient pool ===== -->
      <bpmndi:BPMNShape id="Shape_Participant_Patient" bpmnElement="Participant_Patient" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1360" height="260"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartEvent_Patient" bpmnElement="StartEvent_Patient">
        <dc:Bounds x="220" y="182" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="200" y="225" width="80" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_StartAssessment" bpmnElement="Task_StartAssessment">
        <dc:Bounds x="300" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_FillSymptoms" bpmnElement="Task_FillSymptoms">
        <dc:Bounds x="440" y="160" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_PatientWait" bpmnElement="Gateway_PatientWait">
        <dc:Bounds x="595" y="175" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="580" y="232" width="80" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Event_PatientEmergency" bpmnElement="Event_PatientEmergency">
        <dc:Bounds x="702" y="102" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="682" y="80" width="80" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Event_PatientResult" bpmnElement="Event_PatientResult">
        <dc:Bounds x="702" y="182" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="682" y="225" width="80" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_PatientEmergency" bpmnElement="EndEvent_PatientEmergency">
        <dc:Bounds x="802" y="102" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="782" y="80" width="80" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ReviewResult" bpmnElement="Task_ReviewResult">
        <dc:Bounds x="800" y="160" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_ForwardReport" bpmnElement="Gateway_ForwardReport">
        <dc:Bounds x="955" y="175" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="940" y="232" width="80" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ForwardReport" bpmnElement="Task_ForwardReport">
        <dc:Bounds x="1060" y="160" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Event_PatientReview" bpmnElement="Event_PatientReview">
        <dc:Bounds x="1222" y="182" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1202" y="225" width="80" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_PatientDone" bpmnElement="EndEvent_PatientDone">
        <dc:Bounds x="1322" y="182" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1302" y="225" width="80" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- ===== System pool ===== -->
      <bpmndi:BPMNShape id="Shape_Participant_System" bpmnElement="Participant_System" isHorizontal="true">
        <dc:Bounds x="160" y="380" width="1360" height="300"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartEvent_System" bpmnElement="StartEvent_System">
        <dc:Bounds x="222" y="470" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="202" y="513" width="80" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_MapSymptoms" bpmnElement="Task_MapSymptoms">
        <dc:Bounds x="300" y="448" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_CheckRedFlags" bpmnElement="Task_CheckRedFlags">
        <dc:Bounds x="460" y="448" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Emergency" bpmnElement="Gateway_Emergency">
        <dc:Bounds x="615" y="463" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="600" y="520" width="80" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_RaiseEmergency" bpmnElement="Task_RaiseEmergency">
        <dc:Bounds x="590" y="580" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_SystemEmergency" bpmnElement="EndEvent_SystemEmergency">
        <dc:Bounds x="727" y="602" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="707" y="645" width="80" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_RunModel" bpmnElement="Task_RunModel">
        <dc:Bounds x="720" y="448" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_BuildExplanation" bpmnElement="Task_BuildExplanation">
        <dc:Bounds x="855" y="448" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_PersistResult" bpmnElement="Task_PersistResult">
        <dc:Bounds x="1010" y="448" width="130" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_SendReport" bpmnElement="Task_SendReport">
        <dc:Bounds x="1180" y="448" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_SystemDone" bpmnElement="EndEvent_SystemDone">
        <dc:Bounds x="1342" y="470" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1322" y="513" width="80" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- ===== Doctor pool ===== -->
      <bpmndi:BPMNShape id="Shape_Participant_Doctor" bpmnElement="Participant_Doctor" isHorizontal="true">
        <dc:Bounds x="160" y="720" width="1360" height="200"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartEvent_Doctor" bpmnElement="StartEvent_Doctor">
        <dc:Bounds x="1042" y="802" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1022" y="845" width="80" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_OpenReport" bpmnElement="Task_OpenReport">
        <dc:Bounds x="860" y="780" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ReviewReport" bpmnElement="Task_ReviewReport">
        <dc:Bounds x="620" y="780" width="130" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_MarkReviewed" bpmnElement="Task_MarkReviewed">
        <dc:Bounds x="400" y="780" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_Doctor" bpmnElement="EndEvent_Doctor">
        <dc:Bounds x="302" y="802" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="282" y="845" width="80" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- ===== Patient sequence edges ===== -->
      <bpmndi:BPMNEdge id="Edge_Flow_P1" bpmnElement="Flow_P1">
        <di:waypoint x="256" y="200"/><di:waypoint x="300" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_P2" bpmnElement="Flow_P2">
        <di:waypoint x="400" y="200"/><di:waypoint x="440" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_P3" bpmnElement="Flow_P3">
        <di:waypoint x="550" y="200"/><di:waypoint x="595" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_PtoEmergency" bpmnElement="Flow_PtoEmergency">
        <di:waypoint x="620" y="175"/><di:waypoint x="620" y="120"/><di:waypoint x="702" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_PtoResult" bpmnElement="Flow_PtoResult">
        <di:waypoint x="645" y="200"/><di:waypoint x="702" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_PEmergEnd" bpmnElement="Flow_PEmergEnd">
        <di:waypoint x="738" y="120"/><di:waypoint x="802" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_P4" bpmnElement="Flow_P4">
        <di:waypoint x="738" y="200"/><di:waypoint x="800" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_P5" bpmnElement="Flow_P5">
        <di:waypoint x="910" y="200"/><di:waypoint x="955" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_ForwardYes" bpmnElement="Flow_ForwardYes">
        <di:waypoint x="1005" y="200"/><di:waypoint x="1060" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_ForwardNo" bpmnElement="Flow_ForwardNo">
        <di:waypoint x="980" y="175"/><di:waypoint x="980" y="140"/><di:waypoint x="1340" y="140"/><di:waypoint x="1340" y="182"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_P6" bpmnElement="Flow_P6">
        <di:waypoint x="1170" y="200"/><di:waypoint x="1222" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_P7" bpmnElement="Flow_P7">
        <di:waypoint x="1258" y="200"/><di:waypoint x="1322" y="200"/>
      </bpmndi:BPMNEdge>

      <!-- ===== System sequence edges ===== -->
      <bpmndi:BPMNEdge id="Edge_Flow_S1" bpmnElement="Flow_S1">
        <di:waypoint x="258" y="488"/><di:waypoint x="300" y="488"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_S2" bpmnElement="Flow_S2">
        <di:waypoint x="420" y="488"/><di:waypoint x="460" y="488"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_S3" bpmnElement="Flow_S3">
        <di:waypoint x="570" y="488"/><di:waypoint x="615" y="488"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_EmergYes" bpmnElement="Flow_EmergYes">
